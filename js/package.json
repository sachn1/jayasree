{
  "name": "jayasree",
  "version": "1.0.0",
  "description": "Animated stroke-trace widget for Indic scripts - draws a script's letters as handwriting. The engine only: install a data package such as @jayasree-stroke/ml beside it",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "files": [
    "src/index.js",
    "src/style.css",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.js",
    "./style.css": "./src/style.css"
  },
  "keywords": [
    "malayalam",
    "hindi",
    "devanagari",
    "stroke-order",
    "handwriting",
    "svg",
    "indic",
    "harfbuzz"
  ],
  "author": "Sachin Nandakumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sachn1/jayasree"
  },
  "homepage": "https://github.com/sachn1/jayasree#readme",
  "devDependencies": {},
  "engines": {
    "node": ">=14"
  }
}
